{
  "expo": {
    "name": "BootUp",
    "slug": "BootUp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-final.png",
    "scheme": "bootup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app-icon-final.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.oneangelbdc.BootUp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon-final.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon-final.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d70ca0b-fa22-4cc0-8af3-2d75e57095c7"
      }
    }
  }
}